# ======================================
# Linear Search - Different Approaches
# ======================================

# 1. Linear Search using while loop
def linear_search_while(arr, target):
    i = 0
    while i < len(arr):
        if arr[i] == target:
            return i
        i += 1
    return -1


# 2. Linear Search using for loop
def linear_search_for(arr, target):
    for i in range(len(arr)):
        if arr[i] == target:
            return i
    return -1


# 3. Linear Search without function (manual logic)
def linear_search_manual():
    arr = [1, 2, 3, 4, 5]
    target = int(input("Enter the target number: "))

    i = 0
    found = -1

    while i < len(arr):
        if arr[i] == target:
            found = i
            break
        i += 1

    print("Element found at index:", found)


# 4. Using 'in' and index() (Python built-in)
def linear_search_builtin():
    arr = [10, 20, 30, 40, 50]
    target = 30

    if target in arr:
        print("Element found at index:", arr.index(target))
    else:
        print("Element not found")


# ======================================
# Main Execution
# ======================================
if __name__ == "__main__":
    arr = [1, 2, 3, 4, 5]
    target = int(input("Enter the target number: "))

    print("\n=== While Loop Search ===")
    print("Index:", linear_search_while(arr, target))

    print("\n=== For Loop Search ===")
    print("Index:", linear_search_for(arr, target))

    print("\n=== Manual Search ===")
    linear_search_manual()

    print("\n=== Built-in Search ===")
    linear_search_builtin()
